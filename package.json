{
  "name": "towrite-open-questions",
  "version": "0.3.6",
  "description": "ToThink and ToWrite annotations for Obsidian writing workflows.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite build --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:obsidian:report": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run lint && npm run typecheck && vite build && node scripts/copy-manifest.mjs && node scripts/check-release.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test": "vitest run",
    "deploy:capture": "npm run build && node scripts/deploy-capture.mjs"
  },
  "keywords": [
    "obsidian",
    "open-question",
    "writing",
    "svelte"
  ],
  "author": "Rick",
  "homepage": "https://github.com/GitMorRic/towrite-open-questions#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GitMorRic/towrite-open-questions.git"
  },
  "bugs": {
    "url": "https://github.com/GitMorRic/towrite-open-questions/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "lucide-svelte": "^0.468.0",
    "obsidian": "^1.6.7",
    "svelte": "^4.2.18",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.3.5",
    "vitest": "^2.0.3"
  }
}
